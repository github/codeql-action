{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    /* Basic Options */
    "lib": ["esnext"],
    "module": "preserve",
    "rootDir": "..",
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["./**/*.ts", "../src/**/*.ts"],
  "exclude": [
    "node_modules",
    "../src/testdata/**",
    "../src/**/*.test.ts",
    "../src/testing-utils.ts",
    "../src/json/testing-util.ts",
    "../src/feature-flags/testing-util.ts"
  ]
}
